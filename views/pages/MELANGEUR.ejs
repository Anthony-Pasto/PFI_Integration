<!DOCTYPE html>
<html lang="fr">

<head><%- include('../partials/head') %></head>

<body>
    <%- include('../partials/header') %>
        <main>
            <h2>MELANGEUR</h2>
            <p>Statut de la recette : <span id="recetteStatut">--</span> </p>
            <p>Moteur A : <span id="motA">--</span> </p>
            <p>Moteur B : <span id="motB">--</span> </p>
            <p>Moteur C : <span id="motC">--</span> </p>
            <form onsubmit="event.preventDefault(); envoyerMQTT('MELANGEUR', 'Mode', this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Choisir un mode
                    </option>

                    <option value="AUTO">Auto</option>
                    <option value="MANUEL">Manuel</option>

                </select>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('MELANGEUR', 'motA', this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Choisir un mode
                    </option>

                    <option value="ON">ON</option>
                    <option value="OFF">OFF</option>

                </select>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('MELANGEUR', 'motB', this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Choisir un mode
                    </option>

                    <option value="ON">ON</option>
                    <option value="OFF">OFF</option>

                </select>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('MELANGEUR', 'motC', this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Choisir un mode
                    </option>

                    <option value="ON">ON</option>
                    <option value="OFF">OFF</option>

                </select>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('MELANGEUR', 'recette', this.paiement.value)">

                <div>
                    <label class="form-label fw-bold">
                        Recette
                    </label>

                    <input class="form-control" type="number" name="quantite" placeholder="100-100-100"
                        pattern="[0-999]-[0-999]-[0-999]"required>
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('MELANGEUR', 'recetteGo', this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Choisir un mode
                    </option>

                    <option value="stop">stop </option>
                    <option value="go">go </option>
                    <option value="flush">flush </option>

                </select>

                <button type="submit">Envoyer</button>

            </form>

        </main>
        <%- include('../partials/footer') %>
</body>


<script>


    socket.on('MELANGEUR', function (data) {
        console.log(data.capteur);
        console.log(data.texte);
        const element = document.getElementById(capteur);

        if (!element) return;

        const nombre = Number(texte);
        let valide = false;

        switch (capteur) {

            // État de la recette
            case 'recetteStatut':
                valide = ['PROCESSING', 'FINISHED'].includes(texte);
                break;

            // Moteurs A, B et C
            case 'motA':
            case 'motB':
            case 'motC':
                valide = ['ON', 'OFF'].includes(texte);
                break;

            default:
                console.log('Capteur inconnu :', capteur);
                return;
        }

        if (valide) {
            element.textContent = texte;
        } else {
            console.log('Valeur invalide :', capteur, texte);
        }
    });
</script>

</html>