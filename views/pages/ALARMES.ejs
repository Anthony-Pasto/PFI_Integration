<!DOCTYPE html>
<html lang="fr">

<head><%- include('../partials/head') %></head>

<body>
    <%- include('../partials/header') %>
        <main>
            <h2>ALARMES</h2>
            <p>Grand bassin overflow : <span id="ALR_GB_OVF">--</span> </p>
            <p>Petit bassin overflow : <span id="ALR_PB_OVF">--</span> </p>
            <p>Grand bassin niveau max : <span id="ALR_GB_NIV_MAX">--</span> </p>
            <p>Petit bassin niveau max : <span id="ALR_PB_NIV_MAX">--</span> </p>
            <p>Perte de connexion (balance) : <span id="ALR_CNX_BAL">--</span></p>
            <p>Perte de connexion (powermeter) : <span id="ALR_CNX_POW">--</span></p>

             <form onsubmit="event.preventDefault(); envoyerMQTT('ALARMES', 'NivLhGB', this.quantite.value)">

                <div>
                    <label class="form-label fw-bold">
                        Niveau limite haut grand bassin
                    </label>

                    <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('ALARMES', 'TgNivGB', this.quantite.value)">

                <div>
                    <label class="form-label fw-bold">
                        temps Generation grand bassin 
                    </label>

                    <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('ALARMES', 'TrNivGB', this.quantite.value)">

                <div>
                    <label class="form-label fw-bold">
                        temps Repetition  grand bassin 
                    </label>

                    <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('ALARMES', 'NivLhPB', this.quantite.value)">

                <div>
                    <label class="form-label fw-bold">
                        Niveau limite haut petit bassin
                    </label>

                    <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('ALARMES', 'TgNivPB', this.quantite.value)">

                <div>
                    <label class="form-label fw-bold">
                        temps Generation petit bassin 
                    </label>

                    <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT('ALARMES', 'TrNivPB', this.quantite.value)">

                <div>
                    <label class="form-label fw-bold">
                        temps Repetition  petit bassin 
                    </label>

                    <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                </div>

                <button type="submit">Envoyer</button>

            </form>

            <form onsubmit="event.preventDefault(); envoyerMQTT_ACK('ALR_GB_OVF')">

                <div>
                    <label class="form-label fw-bold">
                        eteindre alarme grand bassin overflow
                    </label>

                    <input class="form-control" type="text"> // mettre le message dans un log
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT_ACK('ALR_PB_OVF')">

                <div>
                    <label class="form-label fw-bold">
                        eteindre alarme petit bassin overflow
                    </label>

                    <input class="form-control" type="text"> // mettre le message dans un log
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT_ACK('ALR_GB_NIV_MAX')">

                <div>
                    <label class="form-label fw-bold">
                        eteindre alarme grand bassin niveau maximum
                    </label>

                    <input class="form-control" type="text"> // mettre le message dans un log
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT_ACK('ALR_PB_NIV_MAX')">

                <div>
                    <label class="form-label fw-bold">
                        eteindre alarme petit bassin niveau maximum
                    </label>

                    <input class="form-control" type="text"> // mettre le message dans un log
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT_ACK('ALR_CNX_BAL')">

                <div>
                    <label class="form-label fw-bold">
                        eteindre alarme perte de connexion balance
                    </label>

                    <input class="form-control" type="text"> // mettre le message dans un log
                </div>

                <button type="submit">Envoyer</button>

            </form>
            <form onsubmit="event.preventDefault(); envoyerMQTT_ACK('ALR_CNX_POW')">

                <div>
                    <label class="form-label fw-bold">
                        eteindre alarme perte de connexion puissance
                    </label>

                    <input class="form-control" type="text"> // mettre le message dans un log
                </div>

                <button type="submit">Envoyer</button>

            </form>


        </main>
        <%- include('../partials/footer') %>
</body>


<script>
    socket.on('ALARMES', function (data) {

        console.log("Alarme reçue :", data);

        const capteur = data.capteur;
        const texte = String(data.texte).trim().toUpperCase();
        const element = document.getElementById(capteur);

        if (!element) return;

        if (texte === 'ON' || texte === 'OFF') {

            element.textContent = texte;

            element.style.color =
                texte === 'ON' ? 'red' : 'green';
        }
    });
</script>

</html>