<!DOCTYPE html>
<html lang="fr">

<head><%- include('../partials/head') %></head>

<body>
    <%- include('../partials/header') %>
        <main>
            <h2>PANNEAU</h2>
            <p>Niveau Grand Bassin : <span id="NivGB">--</span> %</p>
            <p>Niveau Petit Bassin : <span id="NivPB">--</span> %</p>
            <p>Température Petit Bassin : <span id="TmpPB">--</span> C</p>
            <p>Ouverture Grand Bassin : <span id="ValveGB">--</span> %</p>
            <p>Ouverture Petit Bassin : <span id="ValvePB">--</span> %</p>
            <p>Ouverture eau chaude : <span id="ValveEC">--</span> %</p>
            <p>Ouverture eau froide : <span id="ValveEF">--</span> %</p>
            <p>État valve eau chaude : <span id="ValveEEC">--</span> </p>
            <p>État valve eau froide : <span id="ValveEEF">--</span> </p>
            <p>État température active : <span id="TemperatureActive">--</span> </p>
            <p>État pompe : <span id="Pompe">--</span> </p>
            <p>État mode : <span id="Mode">--</span> </p>
            <form onsubmit="event.preventDefault(); changerMode(this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Choisir un mode
                    </option>

                    <option value="AUTO">Auto</option>
                    <option value="MANUEL">Manuel</option>

                </select>

                <button type="submit">Envoyer</button>

            </form>

            <section id="commandes-auto" hidden>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ConsNivGB', this.quantite.value)">

                    <div>
                        <label class="form-label fw-bold">
                            Niveau grand bassin
                        </label>

                        <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                    </div>

                    <button type="submit">Envoyer</button>
                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ConsNivPB', this.quantite.value)">

                    <div>
                        <label class="form-label fw-bold">
                            Niveau petit bassin
                        </label>

                        <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                    </div>

                    <button type="submit">Envoyer</button>
                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ConsTmpPB', this.quantite.value)">

                    <div>
                        <label class="form-label fw-bold">
                            Température bassin
                        </label>

                        <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                    </div>

                    <button type="submit">Envoyer</button>
                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'TemperatureActive', this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Allumer ou éteindre la TemperatureActive
                    </option>


                    <option value="ON">ON</option>
                    <option value="OFF">OFF</option>

                </select>

                <button type="submit">Envoyer</button>

            </form>

            </section>
            <section id="commandes-manuel" hidden>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ValveGB', this.quantite.value)">

                    <div>
                        <label class="form-label fw-bold">
                            Ouverture grand bassin
                        </label>

                        <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                    </div>

                    <button type="submit">Envoyer</button>
                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ValvePB', this.quantite.value)">

                    <div>
                        <label class="form-label fw-bold">
                            Ouverture petit bassin
                        </label>

                        <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                    </div>

                    <button type="submit">Envoyer</button>
                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ValveEC', this.quantite.value)">

                    <div>
                        <label class="form-label fw-bold">
                            Valve eau chaude
                        </label>

                        <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                    </div>

                    <button type="submit">Envoyer</button>
                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ValveEF', this.quantite.value)">

                    <div>
                        <label class="form-label fw-bold">
                            Valve eau froide
                        </label>

                        <input class="form-control" type="number" name="quantite" min="0" max="100" required>
                    </div>

                    <button type="submit">Envoyer</button>

                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ValveEEC', this.paiement.value)">

                    <select class="form-select" id="paiement" name="paiement" required>

                        <option value="" disabled selected>
                            Allumer ou éteindre la valve eau chaude
                        </option>

                        <option value="ON">ON</option>
                        <option value="OFF">OFF</option>

                    </select>

                    <button type="submit">Envoyer</button>

                </form>
                <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'ValveEEF', this.paiement.value)">

                    <select class="form-select" id="paiement" name="paiement" required>

                        <option value="" disabled selected>
                            Allumer ou éteindre la valve eau froide
                        </option>

                        <option value="ON">ON</option>
                        <option value="OFF">OFF</option>

                    </select>

                    <button type="submit">Envoyer</button>

                </form>


            </section>
            <form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'Pompe', this.paiement.value)">

                <select class="form-select" id="paiement" name="paiement" required>

                    <option value="" disabled selected>
                        Allumer ou éteindre la pompe
                    </option>


                    <option value="ON">ON</option>
                    <option value="OFF">OFF</option>

                </select>

                <button type="submit">Envoyer</button>

            </form>

        </main>
        <%- include('../partials/footer') %>
</body>



<script>
    function afficherMode(mode) {
        const valeur = String(mode).trim().toUpperCase();
        if (!['AUTO', 'MANUEL'].includes(valeur)) return;

        document.getElementById('Mode').textContent = valeur;
        document.getElementById('commandes-auto').hidden = valeur !== 'AUTO';
        document.getElementById('commandes-manuel').hidden = valeur !== 'MANUEL';
    }

    function changerMode(mode) {
        afficherMode(mode);
        envoyerMQTT('PANNEAU', 'Mode', mode);
    }

    socket.on('PANNEAU', function (data) {
        const capteur = data.capteur;
        const texteBrut = String(data.texte).trim();
        const texte = capteur === 'Mode' ? texteBrut.toUpperCase() : texteBrut;
        const element = document.getElementById(capteur);
        console.log('MQTT reçu sur la page :', data);
        if (!element) return;

        const nombre = Number(texte);
        let valide = false;


        switch (capteur) {

            // Pourcentage (0 à 100 %)
            case 'NivGB':
            case 'NivPB':
            case 'ValveGB':
            case 'ValvePB':
            case 'ValveEC':
            case 'ValveEF':
                valide = /^\d+(\.\d{1,2})?$/.test(texte)
                    && nombre >= 0 && nombre <= 100;
                break;

            // Température (-40 à 150 °C)
            case 'TmpPB':
                valide = /^-?\d+(\.\d{1,2})?$/.test(texte)
                    && nombre >= -40 && nombre <= 150;
                break;

            // État ON ou OFF
            case 'ValveEEC':
            case 'ValveEEF':
            case 'Pompe':
            case 'TemperatureActive':
                valide = ['ON', 'OFF'].includes(texte);
                break;

            // Mode de fonctionnement
            case 'Mode':
                valide = ['AUTO', 'MANUEL'].includes(texte);
                break;

            default:
                console.log('Capteur inconnu :', capteur);
                return;
        }

        if (valide) {
            element.textContent = texte;
            if (capteur === 'Mode') {
                afficherMode(texte);
            }
        } else {
            console.log('Valeur invalide :', capteur, texte);
        }
    });
</script>

</html>