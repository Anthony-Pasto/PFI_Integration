<!DOCTYPE html>
<html lang="fr">

<head><%- include('../partials/head') %></head>

<body>
    <%- include('../partials/header') %>
        <main>
            <h2>PANNEAU</h2>
            <p>Niveau Grand Bassin : <span id="NivGB">--</span> %</p>
            <p>Niveau Petit Bassin : <span id="NivPB">--</span> %</p>
            <p>Température Petit Bassin : <span id="TmpPB">--</span> C</p>
            <p>Ouverture Grand Bassin : <span id="ValveGB">--</span> %</p>
            <p>Ouverture Petit Bassin : <span id="ValvePB">--</span> %</p>
            <p>Ouverture eau chaude : <span id="ValveEC">--</span> %</p>
            <p>Ouverture eau froide : <span id="ValveEF">--</span> %</p>
            <p>État valve eau chaude : <span id="ValveEEC">--</span> </p>
            <p>État valve eau froide : <span id="ValveEEF">--</span> </p>
            <p>État pompe : <span id="Pompe">--</span> </p>
            <p>État mode : <span id="Mode">--</span> </p>
<form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'Mode', this.paiement.value)">

    <select class="form-select" id="paiement" name="paiement" required>

        <option value="" disabled selected>
            Choisir un mode
        </option>

        <option value="AUTO">Auto</option>
        <option value="MANUEL">Manuel</option>

    </select>

    <button type="submit">Envoyer</button>

</form>


<form onsubmit="event.preventDefault(); envoyerMQTT('PANNEAU', 'NivGB', this.quantite.value)">

    <div>
        <label class="form-label fw-bold">
            Niveau grand bassin
        </label>

        <input
            class="form-control"
            type="number"
            name="quantite"
            min="0"
            max="100"
            required
        >
    </div>

    <button type="submit">Envoyer</button>

</form>


        </main>
        <%- include('../partials/footer') %>
</body>


<script>

    socket.on('PANNEAU', function (data) {
        console.log(data.capteur);
        console.log(data.texte);
        const element = document.getElementById(capteur);

        if (!element) return;

        const nombre = Number(texte);
        let valide = false;

        switch (capteur) {

            // Pourcentage (0 à 100 %)
            case 'NivGB':
            case 'NivPB':
            case 'ValveGB':
            case 'ValvePB':
            case 'ValveEC':
            case 'ValveEF':
                valide = /^\d+(\.\d{1,2})?$/.test(texte)
                    && nombre >= 0 && nombre <= 100;
                break;

            // Température (-40 à 150 °C)
            case 'TmpPB':
                valide = /^-?\d+(\.\d{1,2})?$/.test(texte)
                    && nombre >= -40 && nombre <= 150;
                break;

            // État ON ou OFF
            case 'ValveEEC':
            case 'ValveEEF':
            case 'Pompe':
                valide = ['ON', 'OFF'].includes(texte);
                break;

            // Mode de fonctionnement
            case 'Mode':
                valide = ['AUTO', 'MANUEL'].includes(texte);
                break;

            default:
                console.log('Capteur inconnu :', capteur);
                return;
        }

        if (valide) {
            element.textContent = texte;
        } else {
            console.log('Valeur invalide :', capteur, texte);
        }
    });
</script>

</html>